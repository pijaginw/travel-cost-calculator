{#
This template renders the form for creating a new trip.
It extends a base layout to maintain a consistent look and feel across the application.
#}
{% extends 'base.html.twig' %}

{# Set the title for this specific page #}
{% block title %}Create a New Trip{% endblock %}

{# Define the main content block for the page #}
{% block body %}
    <div class="form-container form-container-wide">
        <h1 class="form-title">Create a New Trip</h1>
        <p class="form-subtitle">
            Start by giving your trip a name and selecting the currency you'll be using for expenses.
        </p>

        {#
        Starts the form rendering.
        'novalidate' disables browser-based validation to rely on Symfony's server-side validation.
        #}
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        {#
        We manually render the label, widget, and errors to apply our custom classes.
        This gives us full control over the markup.
        #}
        <div class="form-group">
            {{ form_label(form.tripName) }}
            {{ form_widget(form.tripName, {'attr': {'class': 'form-control', 'placeholder': 'e.g., Summer in Tokyo'}}) }}
            <div class="form-field-error">
                {{ form_errors(form.tripName) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.tripCurrency) }}
            {{ form_widget(form.tripCurrency, {'attr': {'class': 'form-control'}}) }}
            <div class="form-field-error">
                {{ form_errors(form.tripCurrency) }}
            </div>
        </div>

        {# The button container now uses our custom form-actions for layout #}
        <div class="form-actions form-actions-spaced">
            {# Secondary action: Cancel #}
            <a href="{{ path('app_index') }}" class="button button-secondary">
                Cancel
            </a>

            {# Primary action: Create Trip #}
            <button type="submit" class="button button-primary">
                Create Trip
            </button>
        </div>

        {# Renders the closing </form> tag and any hidden fields (like the CSRF token) #}
        {{ form_end(form) }}
    </div>
{% endblock %}
