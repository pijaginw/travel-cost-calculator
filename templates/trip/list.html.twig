{% extends 'base.html.twig' %}

{% block title %}My Trips{% endblock %}

{% block body %}
    <div class="app-content-panel">

        <div class="data-header">
            <h1>My Trips</h1>
            <a href="{{ path('app_trip_new') }}" class="button button-primary">
                <span class="button-icon-text">+</span> Create New Trip
            </a>
        </div>

        {# --- FLASH MESSAGES --- #}
        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                {{ message }}
            </div>
        {% endfor %}
        {# --- END FLASH MESSAGES --- #}

        {% if trips is empty %}
            <div class="data-empty-state">
                <p class="data-empty-text">You don't have any trips yet.</p>
                <a href="{{ path('app_trip_new') }}" class="button button-primary">
                    Create your first trip
                </a>
            </div>
        {% else %}
            <div class="app-table-responsive">
                <table class="app-table">
                    <thead>
                    <tr>
                        <th class="table-col-main">Name</th>
                        <th>Currency</th>
                        <th class="table-col-date">Created</th>
                        <th class="table-col-actions">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for trip in trips %}
                        <tr>
                            <td class="table-col-main">{{ trip.tripName }}</td>
                            <td>{{ trip.tripCurrency }}</td>
                            <td class="table-col-date">{{ trip.createdAt|date('Y-m-d') }}</td>
                            <td class="table-col-actions">
                                <div class="action-buttons-group">
                                    <a href="{{ path('app_trip_summary', {'id': trip.id}) }}" class="button button-icon" title="View">
                                        👁️
                                    </a>
                                    <form method="POST" action="{{ path('app_trip_delete', {'id': trip.id}) }}" style="display: inline-block" onsubmit="return confirm('Are you absolutely sure you want to delete this trip and all associated expenses?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trip.id) }}">
                                        <button type="submit" class="button button-icon-delete button-icon-danger delete-button-reset" title="Delete">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
