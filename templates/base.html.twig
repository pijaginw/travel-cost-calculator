<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Travel Cost Calculator{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="..." crossorigin="anonymous" />

    {# This assumes you are using AssetMapper (implied by importmap) #}
    {# 'styles/app.css' should be placed in your 'assets/styles/' directory #}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
<header class="app-header">
    <nav class="app-nav">
        <div class="nav-brand">
            <a href="{{ path('app_dashboard') | default('/') }}">Travel Cost Calculator</a>
        </div>
        <div class="nav-user">
            {% if app.user %}
                <span class="user-info">Logged in as {{ app.user.userIdentifier }}</span>
                <a href="{{ path('app_logout') }}" class="button button-secondary">Logout</a>
            {% else %}
                <span class="user-info">Please log in to continue.</span>
                <a href="{{ path('app_login') }}" class="button button-primary">Login</a>
            {% endif %}
        </div>
    </nav>
</header>

<main class="app-content">
    {% block body %}{% endblock %}
</main>

<footer class="app-footer">
    <p>&copy; {{ "now"|date("Y") }} Your Company. All rights reserved.</p>
</footer>

<script>
    (function() {
        const flashMessages = document.querySelectorAll('.flash-message');

        console.log('Found flash messages:', flashMessages.length); // Debug log

        flashMessages.forEach(function(message) {
            message.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            message.style.opacity = '1';

            setTimeout(function() {
                console.log('Hiding message'); // Debug log
                message.style.opacity = '0';
                message.style.transform = 'translateY(-20px)';

                setTimeout(function() {
                    console.log('Removing message'); // Debug log
                    message.remove();
                }, 500);
            }, 5000);
        });
    })();
</script>

</body>
</html>
