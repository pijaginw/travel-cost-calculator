{% extends 'base.html.twig' %}

{% block title %}My Trips{% endblock %}

{% block body %}
    {# The main content wrapper, using the same layout max-width as other pages #}
    <div class="app-content-panel">

        <div class="data-header">
            <h1>My Trips</h1>
            <a href="{{ path('app_trip_new') }}" class="button button-primary">
                {# Assuming you are using a simple icon library or text for "plus" #}
                <span class="button-icon-text">+</span> Create New Trip
            </a>
        </div>

        {# --- FLASH MESSAGES --- #}
        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                {{ message }}
            </div>
        {% endfor %}
        {# --- END FLASH MESSAGES --- #}

        {% if trips is empty %}
            <div class="data-empty-state">
                <p class="data-empty-text">You don't have any trips yet.</p>
                <a href="{{ path('app_trip_new') }}" class="button button-primary">
                    Create your first trip
                </a>
            </div>
        {% else %}
            <div class="app-table-responsive">
                <table class="app-table">
                    <thead>
                    <tr>
                        <th class="table-col-main">Name</th>
                        <th>Currency</th>
                        <th class="table-col-date">Created</th>
                        <th class="table-col-actions">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for trip in trips %}
                        <tr>
                            <td class="table-col-main">{{ trip.tripName }}</td>
                            <td>{{ trip.tripCurrency }}</td>
                            <td class="table-col-date">{{ trip.createdAt|date('Y-m-d') }}</td>
                            <td class="table-col-actions">
                                <div class="action-buttons-group">
                                    {# NOTE: Replaced icon classes (i.e., 'bi bi-eye') with text/simple icons #}
                                    <a href="#" class="button button-icon" title="View">
                                        👁️
                                    </a>
                                    <a href="#" class="button button-icon" title="Edit">
                                        ✏️
                                    </a>
                                    <a href="#" class="button button-icon button-icon-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this trip?')">
                                        🗑️
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
